{
  "id": "openrouter-model-compare",
  "task": "找到并比较适合的模型",
  "pageBinding": {
    "urlPattern": "openrouter.ai/models",
    "landmarks": ["Compare AI Models: Pricing, Context & Benchmarks"]
  },
      "steps": [
        {
          "id": 1,
          "primary": { "strategy": "placeholder", "value": "Search models..." },
          "fallback": { "strategy": "css", "value": "input[type=text][placeholder*=\"Search\"]" },
          "completion": { "type": "input" },
          "comment": "在搜索框输入模型名（如 claude），输入后自动进入下一步。"
        },
        {
          "id": 2,
          "primary": { "strategy": "text", "value": "Models" },
          "fallback": { "strategy": "css", "value": "nav a" },
          "completion": { "type": "click" },
          "comment": "点击主导航的 Models 页签确认位置：选模型从这里进，比较跑分去 Benchmarks。"
        },
        {
          "id": 3,
          "primary": { "strategy": "text", "value": "Context length" },
          "fallback": { "strategy": "css", "value": "h3" },
          "completion": { "type": "click" },
          "comment": "点击展开「Context length」筛选区：按模型能一次处理的最大上下文长度过滤，长文任务选大的。"
        },
        {
          "id": 4,
          "primary": { "strategy": "css", "value": "a[href*=\"/models/\"]" },
          "fallback": { "strategy": "css", "value": "main li" },
          "completion": { "type": "click" },
          "comment": "点击任意模型卡片进入详情，查看价格、上下文与供应商，完成任务。"
        }
      ]
}
