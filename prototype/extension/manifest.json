{
  "manifest_version": 3,
  "name": "Page Guide Agent (开发版)",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "由 Codex 对话调用 MCP，在网页上定位元素并显示标注。",
  "icons": {
    "16": "icons/page-guide-agent-16.png",
    "32": "icons/page-guide-agent-32.png",
    "48": "icons/page-guide-agent-48.png",
    "128": "icons/page-guide-agent-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8767/*"
  ],
  "action": {
    "default_title": "在 Codex 对话中使用 Page Guide Agent",
    "default_icon": {
      "16": "icons/page-guide-agent-16.png",
      "32": "icons/page-guide-agent-32.png",
      "48": "icons/page-guide-agent-48.png",
      "128": "icons/page-guide-agent-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
